# DATABASE_URL: cadena de conexión de Neon (Dashboard > Connect). Solo se usa en el servidor (carpeta api/).
# NO le pongas prefijo VITE_ o quedaría expuesta en el navegador.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ADMIN_PASSWORD: contraseña para entrar a /admin (ver y descargar registros). Solo en el servidor.
ADMIN_PASSWORD="elige-una-contraseña-larga"
